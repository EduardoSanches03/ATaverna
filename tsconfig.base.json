{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    // O @ataverna/shared é consumido como fonte .ts (o Node roda tirando os tipos), então os
    // imports relativos dele levam a extensão real.
    "rewriteRelativeImportExtensions": true
  }
}
